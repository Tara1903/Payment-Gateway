# Supabase Database & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# JWT Token Signing (Order Payment Tokens)
ORDER_JWT_SECRET=your-32-character-minimum-secret-key-here
JWT_ISSUER=starpay

# Android Companion Security
ANDROID_WEBHOOK_SECRET=default-starpay-companion-hmac-secret-key

# Transaction Notifications & Invoicing
RESEND_API_KEY=re_123456789_your_resend_api_key
RESEND_FROM_EMAIL=payments@yourdomain.com

# Cron Job Security (Order Expiry Task)
CRON_SECRET=your-random-cron-secret-key

# General App URL
NEXT_PUBLIC_APP_URL=https://pay.yourdomain.com